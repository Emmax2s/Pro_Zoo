# Archivo .env para PRODUCCIÓN - Pro Zoo (pruzo.me)
# Copia este archivo a .env y reemplaza los valores con tus credenciales reales

# Frontend - URL del dominio
VITE_API_BASE_URL=https://pruzo.me

# Backend - Puerto de la API
PORT=4000

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_CONTRASEÑA_SEGURA_AQUI_12345
POSTGRES_DATABASE=pro_zoo

# Admin & Security - GENERAR CLAVES SEGURAS
ADMIN_API_KEY=generar-clave-aleatoria-segura-aqui
CORS_ORIGIN=https://pruzo.me
JWT_SECRET=generar-jwt-secret-aleatorio-muy-seguro-aqui

# ⚠️ IMPORTANTE ⚠️
# 1. Cambia POSTGRES_PASSWORD a una contraseña fuerte
# 2. Genera ADMIN_API_KEY: usar `openssl rand -base64 32`
# 3. Genera JWT_SECRET: usar `openssl rand -base64 32`
# 4. Nunca compartas este archivo
# 5. Añade .env a .gitignore (ya hecho en el repo)
