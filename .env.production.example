# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE PRODUCCIÓN - PRO ZOO & ASISTENTE VIRTUAL ZOOMAT
# Dominio Oficial: https://www.zoomat.chiapas.gob.mx/
# ==============================================================================
# Copia este archivo como .env y reemplaza los marcadores <REDACTADO_*> con credenciales reales.
# NUNCA compartas ni subas archivos .env con credenciales reales al repositorio.

# ──────────────────────────────────────────────────────────────────────────────
# 1. FRONTEND WEB (React / Vite)
# ──────────────────────────────────────────────────────────────────────────────
# URL base de la API REST del backend Node.js (usar ruta absoluta o subruta '/api')
VITE_API_BASE_URL=https://www.zoomat.chiapas.gob.mx/api

# URL del Asistente Virtual embebido en el iframe (compatible con subruta '/chatbot/' o subdominio)
VITE_CHATBOT_URL=https://www.zoomat.chiapas.gob.mx/chatbot/

# Clave de API para operaciones administrativas en el frontend
VITE_ADMIN_API_KEY=<REDACTADO_ADMIN_API_KEY>

# ──────────────────────────────────────────────────────────────────────────────
# 2. BACKEND API (Node.js / Express)
# ──────────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Base de datos PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REDACTADO_POSTGRES_PASSWORD>
POSTGRES_DATABASE=pro_zoo
POSTGRES_SSL=false

# Seguridad y Autenticación Administrativa
ADMIN_API_KEY=<REDACTADO_ADMIN_API_KEY>
JWT_SECRET=<REDACTADO_JWT_SECRET_32_BYTES>

# Orígenes CORS autorizados para la API Node.js (separados por coma)
CORS_ORIGIN=https://www.zoomat.chiapas.gob.mx,https://zoomat.chiapas.gob.mx

# URL pública del portal institucional (usada en correos de restablecimiento y enlaces)
PUBLIC_APP_URL=https://www.zoomat.chiapas.gob.mx

# Configuración de Servidor de Correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notificaciones@zoomat.chiapas.gob.mx
SMTP_PASSWORD=<REDACTADO_SMTP_APP_PASSWORD>
MAIL_FROM=ZooMAT Oficial <noreply@zoomat.chiapas.gob.mx>

# ──────────────────────────────────────────────────────────────────────────────
# 3. ASISTENTE VIRTUAL CHATBOT (Python / Flask / Waitress)
# ──────────────────────────────────────────────────────────────────────────────
CHATBOT_PORT=8000
WAITRESS_THREADS=8
CHATBOT_DEBUG=false

# Orígenes CORS permitidos para el Chatbot
CORS_ORIGINS=https://www.zoomat.chiapas.gob.mx,https://zoomat.chiapas.gob.mx,https://pruzo.me

# Directiva Content-Security-Policy frame-ancestors para autorizar el embebido en iframe
FRAME_ANCESTORS=frame-ancestors 'self' https://www.zoomat.chiapas.gob.mx https://zoomat.chiapas.gob.mx https://pruzo.me https://www.pruzo.me http://localhost:* http://127.0.0.1:*

# Clave secreta para endpoint de ingesta semanal
INGEST_SECRET=<REDACTADO_INGEST_SECRET>

# Conexión al Daemon Local de Ollama (LLM Llama 3.1)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Base de datos logística MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=<REDACTADO_MYSQL_PASSWORD>
DB_NAME=zoomat_db
